+// limitations under the License.
+
+#include "libspu/compiler/compile_stablehlo.h"
+
+#include <utility>
+
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/Parser/Parser.h"
+#include "mlir/Pass/Pass.h"
+#include "mlir/Pass/PassManager.h"
+#include "stablehlo/dialect/StablehloOps.h"
+
+#include "libspu/compiler/codegen/codegen.h"
+#include "libspu/compiler/common/compilation_context.h"
+#include "libspu/compiler/core/core.h"
+#include "libspu/compiler/utils/utils.h"
+#include "libspu/core/prelude.h"
+#include "libspu/dialect/pphlo/IR/dialect.h"
+#include "libspu/dialect/pphlo/transforms/passes.h"
+
+namespace spu::compiler {
+
+std::string compileStablehloOnly(
+    std::string_view stablehlo,
+    const std::vector<Visibility>& input_visibility,
+    const CompilerOptions& copts) {
+  CompilationContext context(copts);
+  auto* mlir_context = context.getMLIRContext();
+  mlir_context->loadDialect<mlir::spu::pphlo::PPHloDialect,
+                            mlir::stablehlo::StablehloDialect,
+                            mlir::func::FuncDialect>();
+
+  auto module = mlir::parseSourceString<mlir::ModuleOp>(
+      std::string(stablehlo), mlir_context);
+  SPU_ENFORCE(module, "MLIR parser failure");
+
+  std::string input_vis_args = "input_vis_list=";
+  for (size_t index = 0; index < input_visibility.size(); ++index) {
+    if (index != 0) {
+      input_vis_args.append(",");
+    }
+    input_vis_args.append(Visibility_Name(input_visibility[index]));
+  }
+
+  mlir::PassManager frontend(mlir_context);
+  auto legalize = mlir::spu::pphlo::createLegalizeToPPHloPass();
+  SPU_ENFORCE(
+      legalize
+          ->initializeOptions(input_vis_args,
+                              mlir::spu::argparser_error_handler)
+          .succeeded(),
+      "Failed to initialize StableHLO visibility options");
+  frontend.addPass(std::move(legalize));
+  frontend.nest<mlir::func::FuncOp>().addPass(
+      mlir::spu::pphlo::createLowerConversionCastPass());
+  context.setupPrettyPrintConfigurations(&frontend);
+  SPU_ENFORCE(frontend.run(module.get()).succeeded(),
+              "Failed to legalize StableHLO to PPHLO");
+
+  Core core(&context);
+  core.doit(module.get());
+  return CodeGen::doit(module.get());
+}
+
+}  // namespace spu::compiler
