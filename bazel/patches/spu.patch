+NdArrayRef BasicOTProtocols::Multiplexer_gf2(const NdArrayRef &msg,
+                                             const NdArrayRef &select) {
+  SPU_ENFORCE_EQ(msg.shape(), select.shape());
+  const auto *shareType = select.eltype().as<BShrTy>();
+  SPU_ENFORCE_EQ(shareType->nbits(), 1UL);
+
+  const auto field = msg.eltype().as<Ring2k>()->field();
+  const int64_t size = msg.numel();
+
+  auto _corr_data = ring_zeros(field, msg.shape());
+
+  auto _send_msg0 = ring_zeros(field, msg.shape());
+  auto _send_msg1 = ring_zeros(field, msg.shape());
+  auto _recv = ring_zeros(field, msg.shape());
+  std::vector<uint8_t> sel(size);
+  // Compute (x0 ^ x1) * (b0 ^ b1)
+  // Also ( (x0 ^ x1 ) * b0 ) ^ ( (x0 ^ x1) * b1 )
+  return DISPATCH_ALL_FIELDS(field, [&]() {
+    NdArrayView<const ring2k_t> _msg(msg);
+    NdArrayView<const ring2k_t> _sel(select);
+    auto corr_data = absl::MakeSpan(&_corr_data.at<ring2k_t>(0), size);
+    auto send_msg0 = absl::MakeSpan(&_send_msg0.at<ring2k_t>(0), size);
+    auto send_msg1 = absl::MakeSpan(&_send_msg1.at<ring2k_t>(0), size);
+    auto recv = absl::MakeSpan(&_recv.at<ring2k_t>(0), size);
+
+    pforeach(0, size, [&](int64_t i) {
+      sel[i] = static_cast<uint8_t>(_sel[i] & 1);
+      corr_data[i] = _msg[i];
+    });
+
+    if (Rank() == 0) {
+      ferret_sender_->SendRMCC(send_msg0, send_msg1);
+      ferret_sender_->Flush();
+      ferret_receiver_->RecvRMCC(absl::MakeSpan(sel), recv);
+      ring_xor_(_send_msg1, _send_msg0);
+      ring_xor_(_send_msg1, _corr_data);
+      conn_->sendAsync(conn_->nextRank(), _send_msg1, "Multiplexer_gf2");
+      auto delta = conn_->recv(conn_->nextRank(), _send_msg1.eltype(),
+                               "Multiplexer_gf2");
+      ring_xor_(_corr_data, delta);
+    } else {
+      ferret_receiver_->RecvRMCC(absl::MakeSpan(sel), recv);
+      ferret_sender_->SendRMCC(send_msg0, send_msg1);
+      ferret_sender_->Flush();
+      ring_xor_(_send_msg1, _send_msg0);
+      ring_xor_(_send_msg1, _corr_data);
+      auto delta = conn_->recv(conn_->nextRank(), _send_msg1.eltype(),
+                               "Multiplexer_gf2");
+      conn_->sendAsync(conn_->nextRank(), _send_msg1, "Multiplexer_gf2");
+      ring_xor_(_corr_data, delta);
+    }
+
+    pforeach(0, size, [&](int64_t i) {
+      recv[i] =
+          corr_data[i] * static_cast<ring2k_t>(sel[i]) ^ send_msg0[i] ^ recv[i];
+    });
+
+    return _recv;
+  });
+}
