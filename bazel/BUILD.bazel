package(default_visibility = ["//visibility:public"])

# Use system preinstalled make instead of building from source
# This avoids sandbox issues on macOS ARM64
toolchain(
    name = "preinstalled_make_toolchain",
    toolchain = "@rules_foreign_cc//toolchains/private:preinstalled_make",
    toolchain_type = "@rules_foreign_cc//toolchains:make_toolchain",
)

config_setting(
    name = "capricorn_build_as_release",
    values = {"compilation_mode": "opt"},
)

config_setting(
    name = "capricorn_build_as_debug",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "capricorn_build_as_fast",
    values = {"compilation_mode": "fastbuild"},
)
