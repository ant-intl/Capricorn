_COMPARE_TEST_CASES = {
    "compare_msb_test": "CompareTest.MSBTest",
    "compare_public_value_test": "CompareTest.CompareWithPublicValueTest",
    "compare_sub_block_test": "CompareTest.SubBlockCompareTest",
    "compare_unsigned_test": "CompareTest.UnsignedCompareTest",
    "compare_wrap_test": "CompareTest.WrapTest",
}

[
    capricorn_cc_test_with_main(
        name = target_name,
        srcs = ["compare_test.cc"],
        args = ["--gtest_filter={}".format(test_filter)],
        deps = [
            ":and_protocol",
            ":compare",
            ":rot_context",
            "//src/common/runtime/link:mock_link_io",
            "@emp-tool",
            "@yacl//yacl/link",
        ],
    )
    for target_name, test_filter in _COMPARE_TEST_CASES.items()
]

test_suite(
    name = "compare_test",
    tests = [":" + target_name for target_name in _COMPARE_TEST_CASES.keys()],
)

