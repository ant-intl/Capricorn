load("//bazel:capricorn.bzl", "capricorn_cc_library", "capricorn_cc_test", "capricorn_cc_test_with_main")

package(default_visibility = ["//visibility:public"])

capricorn_cc_library(
    name = "simd_batchmm_prot",
    srcs = ["simd_batchmm_prot.cc"],
    hdrs = ["simd_batchmm_prot.h"],
    deps = [
        "@seal",
        "@spulib//libspu/core:ndarray_ref",
        "@spulib//libspu/mpc/cheetah/arith:arith_comm",
    ],
)

capricorn_cc_library(
    name = "batch_matmul",
    srcs = ["batch_matmul.cc"],
    hdrs = ["batch_matmul.h"],
    deps = [
        "simd_batchmm_prot",
        "@seal",
        "@spulib//libspu/core:ndarray_ref",
        "@spulib//libspu/mpc/cheetah/arith:arith_comm",
        "@spulib//libspu/mpc/cheetah/rlwe:packlwes",
        "@yacl//yacl/utils:elapsed_timer",
    ],
)

capricorn_cc_test(
    name = "simd_batchmm_test",
    srcs = ["simd_batchmm_prot_test.cc"],
    deps = [
        ":simd_batchmm_prot",
        "@spulib//libspu/mpc/utils:ring_ops",
        "@spulib//libspu/mpc/utils:simulate",
        "@yacl//yacl/utils:elapsed_timer",
    ],
)

capricorn_cc_test(
    name = "batch_matmul_test",
    srcs = ["batch_matmul_test.cc"],
    deps = [
        ":batch_matmul",
        "@spulib//libspu/mpc/utils:ring_ops",
        "@spulib//libspu/mpc/utils:simulate",
        "@yacl//yacl/utils:elapsed_timer",
    ],
)
