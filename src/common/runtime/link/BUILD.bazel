load("//bazel:capricorn.bzl", "capricorn_cc_library")

package(default_visibility = ["//visibility:public"])

capricorn_cc_library(
    name = "communicator",
    hdrs = ["communicator.h"],
    deps = [
        "@abseil-cpp//absl/types:span",
        "@yacl//yacl/base:buffer",
        "@yacl//yacl/link",
    ],
)

capricorn_cc_library(
    name = "link_io",
    hdrs = ["link_io.h"],
    deps = [
        ":communicator",
        "@abseil-cpp//absl/strings",
        "@emp-tool//:emp-tool",
    ],
)

capricorn_cc_library(
    name = "mock_link_io",
    hdrs = ["mock_link_io.h"],
    deps = [
        ":communicator",
        ":link_io",
        "//src/common/runtime:test_utils",
        "@abseil-cpp//absl/strings",
        "@yacl//yacl/link",
        "@yacl//yacl/utils:thread_pool",
    ],
)
